# Discord bot token (required)
# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token

# Jules API key (required)
JULES_API_KEY=your-jules-api-key

# ── Auto-managed mode ─────────────────────────────────────────────────────────
# When GUILD_ID is set the bot manages its own Discord structure automatically:
#   • One category per GitHub repo connected to your Jules account
#   • One text channel per Jules session under the matching category
#   • A special #new-task channel per repo — send a message there to open a
#     new Jules session and get a dedicated channel for it
# access.json is NOT required in this mode.

# Your Discord server (guild) ID (right-click the server → Copy Server ID).
# GUILD_ID=your-guild-id

# How often (in milliseconds) to poll Jules for new/updated sessions.
# (optional, defaults to 120000 = 2 minutes, minimum 10000)
# POLL_INTERVAL_MS=120000

# How many sessions to sync per poll cycle (most recent N).
# Increase if you have more than 50 Jules sessions you want tracked.
# (optional, defaults to 50)
# SYNC_SESSION_LIMIT=50

# Comma-separated Discord user IDs allowed to interact with managed channels.
# Leave unset to allow everyone who can see the channel (recommended: let
# Discord's own channel permissions handle access control).
# ALLOWED_USER_IDS=111111111111111111,222222222222222222

# ── Legacy / manual mode ──────────────────────────────────────────────────────
# If GUILD_ID is not set, the bot falls back to access.json-based channel
# configuration (see access.json.example).

# Path to access policy JSON (optional, defaults to ./access.json)
# ACCESS_JSON=/absolute/path/to/access.json

# ── Storage ───────────────────────────────────────────────────────────────────
# Where session pointers (channelId → sessionId) are persisted
# (optional, defaults to ./state)
# STATE_DIR=/absolute/path/to/state

# ── Limits ────────────────────────────────────────────────────────────────────
# Max bytes per Discord attachment we'll fetch and forward
# (optional, defaults to 25 MiB)
# MAX_ATTACHMENT_BYTES=26214400

# Max bytes per IMAGE attachment (Jules API caps images at 5MB)
# Larger images are rejected with a clear error before upload.
# (optional, defaults to 5 MiB)
# MAX_IMAGE_BYTES=5242880

# Close per-channel agents after this many minutes of inactivity. The session
# pointer persists, so the next message resumes the conversation (paying an
# ~8s cold start once). Set to 0 to disable idle eviction (agents live forever).
# (optional, defaults to 30)
# IDLE_MINUTES=30

# Hard cap on simultaneously-live agents. When exceeded and a new channel
# wants an agent, the LRU non-busy agent is evicted.
# (optional, defaults to 8)
# MAX_ACTIVE_AGENTS=8
